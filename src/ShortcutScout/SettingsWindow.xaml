<Window x:Class="ShortcutScout.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShortcutScout settings" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#FF16161A" FontFamily="Consolas">

  <Window.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#FFB8B8C0"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style TargetType="Slider">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="10,0"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="Margin" Value="6,0,0,0"/>
      <Setter Property="Background" Value="#FF26262E"/>
      <Setter Property="Foreground" Value="#FF39FF14"/>
      <Setter Property="BorderBrush" Value="#FF3A3A46"/>
      <Setter Property="FontFamily" Value="Consolas"/>
    </Style>
    <Style x:Key="Value" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#FF39FF14"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
  </Window.Resources>

  <StackPanel Margin="18">
    <TextBlock Text="ShortcutScout" Foreground="#FF39FF14" FontSize="15" FontWeight="Bold"/>
    <TextBlock Text="Changes apply as you drag them and are written to config/shortcuts.json."
               FontSize="11" Foreground="#FF7A7A86" TextWrapping="Wrap" Margin="0,6,0,14"/>

    <Grid Margin="0,4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="160"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="56"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="Mode"/>
      <ComboBox x:Name="ModeBox" Grid.Column="1" Grid.ColumnSpan="2" FontFamily="Consolas">
        <ComboBoxItem Content="peek (hidden while you work)"/>
        <ComboBoxItem Content="ambient (always visible)"/>
      </ComboBox>
    </Grid>

    <Grid Margin="0,4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="160"/><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="Text size"/>
      <Slider x:Name="FontSlider" Grid.Column="1" Minimum="9" Maximum="24" SmallChange="1" IsSnapToTickEnabled="True" TickFrequency="1"/>
      <TextBlock x:Name="FontValue" Grid.Column="2" Style="{StaticResource Value}"/>
    </Grid>

    <Grid Margin="0,4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="160"/><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="Width"/>
      <Slider x:Name="WidthSlider" Grid.Column="1" Minimum="240" Maximum="900" SmallChange="10" TickFrequency="10" IsSnapToTickEnabled="True"/>
      <TextBlock x:Name="WidthValue" Grid.Column="2" Style="{StaticResource Value}"/>
    </Grid>

    <Grid Margin="0,4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="160"/><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="Rows shown"/>
      <Slider x:Name="RowsSlider" Grid.Column="1" Minimum="2" Maximum="16" SmallChange="1" TickFrequency="1" IsSnapToTickEnabled="True"/>
      <TextBlock x:Name="RowsValue" Grid.Column="2" Style="{StaticResource Value}"/>
    </Grid>

    <Grid Margin="0,4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="160"/><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="Peek duration (s)"/>
      <Slider x:Name="PeekSlider" Grid.Column="1" Minimum="2" Maximum="30" SmallChange="1" TickFrequency="1" IsSnapToTickEnabled="True"/>
      <TextBlock x:Name="PeekValue" Grid.Column="2" Style="{StaticResource Value}"/>
    </Grid>

    <Grid Margin="0,4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="160"/><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="Re-show every (s)"/>
      <Slider x:Name="RePeekSlider" Grid.Column="1" Minimum="0" Maximum="600" SmallChange="10" TickFrequency="10" IsSnapToTickEnabled="True"/>
      <TextBlock x:Name="RePeekValue" Grid.Column="2" Style="{StaticResource Value}"/>
    </Grid>

    <Grid Margin="0,4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="160"/><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="Rotate rows every (s)"/>
      <Slider x:Name="RotateSlider" Grid.Column="1" Minimum="0" Maximum="60" SmallChange="1" TickFrequency="1" IsSnapToTickEnabled="True"/>
      <TextBlock x:Name="RotateValue" Grid.Column="2" Style="{StaticResource Value}"/>
    </Grid>

    <Grid Margin="0,4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="160"/><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="Idle reveal after (s)"/>
      <Slider x:Name="IdleSlider" Grid.Column="1" Minimum="5" Maximum="300" SmallChange="5" TickFrequency="5" IsSnapToTickEnabled="True"/>
      <TextBlock x:Name="IdleValue" Grid.Column="2" Style="{StaticResource Value}"/>
    </Grid>

    <Grid Margin="0,4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="160"/><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="Ambient opacity"/>
      <Slider x:Name="OpacitySlider" Grid.Column="1" Minimum="0.54" Maximum="1" SmallChange="0.02" TickFrequency="0.02" IsSnapToTickEnabled="True"/>
      <TextBlock x:Name="OpacityValue" Grid.Column="2" Style="{StaticResource Value}"/>
    </Grid>

    <TextBlock x:Name="HintText" FontSize="11" Foreground="#FF8A8A96" TextWrapping="Wrap"
               Margin="0,14,0,0"
               Text="Re-show every 0 disables periodic reveals: the panel then only appears when you switch windows or walk away. Rotate rows every 0 holds the list still while it is on screen."/>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button x:Name="ConfigButton" Content="Open config folder"/>
      <Button x:Name="CloseButton" Content="Close"/>
    </StackPanel>
  </StackPanel>
</Window>
